# Sao chép thành .env rồi điền giá trị thật (KHÔNG commit .env)
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/Hotel-RAG
JWT_SECRET=<chuoi-bi-mat-dai-ngau-nhien>

# Trợ lý AI: chỉ dùng model chạy bằng Ollama (máy cá nhân hoặc Colab qua tunnel)
#   OLLAMA_MODEL: model viết câu trả lời | OLLAMA_EMBED_MODEL: model tạo vector tìm kiếm
#   LLM_PROVIDER=off để tắt phần viết câu trả lời (chatbot trả câu dựng sẵn)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=dolphin3
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_MS=

# VNPay sandbox
VNP_TMN_CODE=<ma-website>
VNP_HASH_SECRET=<chuoi-bi-mat>
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5173/payment/vnpay-return

# Tùy chọn: chỉ cho phép các domain frontend này gọi API (cách nhau dấu phẩy)
CORS_ORIGIN=

# Email xác nhận đăng ký / quên mật khẩu
# console (mặc định): không gửi thật, in link ra log | brevo: gửi qua Brevo HTTP API (dùng được trên Render free)
MAIL_PROVIDER=console
BREVO_API_KEY=
# Địa chỉ người gửi đã xác minh trong Brevo (Senders), có thể là Gmail của nhóm
MAIL_FROM=
MAIL_FROM_NAME=Nestly
# Địa chỉ trang web dùng trong link email (mặc định lấy CORS_ORIGIN, rồi http://localhost:5173)
APP_URL=http://localhost:5173
# required | off. Không đặt = bắt buộc xác nhận email khi đã cấu hình gửi mail thật (brevo)
EMAIL_VERIFICATION=
